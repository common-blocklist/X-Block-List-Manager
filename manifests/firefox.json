{
  "manifest_version": 2,
  "name": "X Block List Manager",
  "version": "1.3.0",
  "description": "Mass block / unblock X.com accounts from a list, build your own lists from profile pages, and keep a log of who you blocked.",
  "browser_specific_settings": {
    "gecko": {
      "id": "x-blocklist-manager@local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://raw.githubusercontent.com/*",
    "https://gist.githubusercontent.com/*",
    "https://gitlab.com/*",
    "https://codeberg.org/*"
  ],
  "browser_action": {
    "default_title": "X Block List Manager",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "lists-common.js",
        "profile-button.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
